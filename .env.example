# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: ignora RLS
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app
NEXT_PUBLIC_APP_URL=

# Notificaciones push (VAPID) — generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Secreto para que Supabase pg_cron llame a /api/push/cron
CRON_SECRET=
